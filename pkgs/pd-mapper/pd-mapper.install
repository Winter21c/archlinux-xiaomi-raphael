post_install() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable pd-mapper.service >/dev/null 2>&1 || true

  echo ">>> pd-mapper.service enabled."
  echo ">>> On kernel 7.2.0 with CONFIG_QCOM_PD_MAPPER=m the IN-KERNEL"
  echo ">>> qcom_pd_mapper.ko also serves servreg_loc for qcom,sm8150."
  echo ">>> Verify with:  systemctl status pd-mapper ; qrtr-lookup"
  echo ">>> If pd-mapper cannot register the service, mask the userspace unit:"
  echo ">>>   systemctl disable --now pd-mapper.service"
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable pd-mapper.service >/dev/null 2>&1 || true
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
}
