post_install() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable tqftpserv.service >/dev/null 2>&1 || true
  echo ">>> tqftpserv.service enabled (modem firmware/file TFTP server)."
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable tqftpserv.service >/dev/null 2>&1 || true
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
}
